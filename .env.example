# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bizboost?schema=public"
# For local quick start you can use SQLite:
# DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-here"

# AI (OpenAI-compatible — Grok, OpenAI, local, etc.)
AI_API_KEY=""
AI_BASE_URL="https://api.x.ai/v1"
AI_MODEL="grok-3"

# ------------------------------------------------------------
# PLATFORM-LEVEL credentials (managed by BizBoost, NOT by end users)
# Users never connect Buffer/Canva/Gamma/HubSpot themselves.
# These power built-in features behind the scenes.
# ------------------------------------------------------------

# Buffer — organic social publishing engine
BUFFER_ACCESS_TOKEN=""
BUFFER_ORGANIZATION_ID=""

# Canva — design generation (server-side)
CANVA_API_KEY=""

# Gamma — presentations & documents
GAMMA_API_KEY=""

# HubSpot — optional CRM backend enrichment
HUBSPOT_ACCESS_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BizBoost"
