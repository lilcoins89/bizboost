# ============================================================
# BizBoost environment variables
# Copy to .env for local, or set in Vercel Project Settings
# ============================================================

# Database (PostgreSQL required for production / Vercel)
# Free options: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/bizboost?sslmode=require"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# AI (optional — app works with built-in fallbacks if empty)
AI_API_KEY=""
AI_BASE_URL="https://api.x.ai/v1"
AI_MODEL="grok-3"

# ------------------------------------------------------------
# PLATFORM credentials (server-side only)
# Users never connect Buffer/Canva/Gamma/HubSpot themselves.
# Leave empty for demo; features still work in UI.
# ------------------------------------------------------------
BUFFER_ACCESS_TOKEN=""
BUFFER_ORGANIZATION_ID=""
CANVA_API_KEY=""
GAMMA_API_KEY=""
HUBSPOT_ACCESS_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BizBoost"
